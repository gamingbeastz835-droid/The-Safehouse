rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  function self(uid){return signedIn() && request.auth.uid==uid;}
  function chatMember(id){return signedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(id)).data.members;}
  function serverMember(id){return signedIn() && request.auth.uid in get(/databases/$(database)/documents/servers/$(id)).data.memberIds;}
  match /users/{uid}{
   allow read: if signedIn();
   allow create: if self(uid) && request.resource.data.uid==uid && request.resource.data.email==request.auth.token.email;
   allow update: if self(uid) && request.resource.data.uid==resource.data.uid && request.resource.data.email==resource.data.email && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["displayName","bio","photoURL","lastSeen"]);
   allow delete: if false;
  }
  match /friendRequests/{id}{
   allow create: if signedIn() && request.resource.data.from==request.auth.uid && request.resource.data.to!=request.auth.uid && request.resource.data.status=="pending";
   allow read: if signedIn() && (resource.data.from==request.auth.uid || resource.data.to==request.auth.uid);
   allow update: if signedIn() && resource.data.to==request.auth.uid && request.resource.data.from==resource.data.from && request.resource.data.to==resource.data.to && request.resource.data.status in ["accepted","declined"];
   allow delete: if false;
  }
  match /friendships/{id}{
   allow read: if signedIn() && request.auth.uid in resource.data.users;
   allow create: if signedIn() && request.auth.uid in request.resource.data.users && request.resource.data.users.size()==2;
   allow update,delete: if false;
  }
  match /chats/{id}{
   allow create: if signedIn() && request.auth.uid in request.resource.data.members && request.resource.data.members.size()>=2 && request.resource.data.members.size()<=50 && request.resource.data.createdBy==request.auth.uid;
   allow read: if signedIn() && request.auth.uid in resource.data.members;
   allow update: if signedIn() && request.auth.uid in resource.data.members && request.resource.data.members==resource.data.members && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["lastMessage","updatedAt","unread"]);
   allow delete: if false;
   match /messages/{messageId}{
    allow read: if chatMember(id);
    allow create: if chatMember(id) && request.resource.data.senderId==request.auth.uid && request.resource.data.text is string && request.resource.data.text.size()>0 && request.resource.data.text.size()<=4000;
    allow update: if chatMember(id) && request.auth.uid in resource.data.readBy && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["readBy"]) && request.auth.uid in request.resource.data.readBy;
    allow delete: if false;
   }
   match /typing/{uid}{
    allow read: if chatMember(id);
    allow create,update: if chatMember(id) && request.auth.uid==uid && request.resource.data.uid==uid;
    allow delete: if self(uid);
   }
  }
  match /servers/{id}{
   allow create: if signedIn() && request.resource.data.ownerId==request.auth.uid && request.auth.uid in request.resource.data.memberIds;
   allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
   allow update: if signedIn() && request.auth.uid in resource.data.memberIds && request.resource.data.ownerId==resource.data.ownerId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["memberIds"]) && request.resource.data.memberIds.size()==resource.data.memberIds.size()+1 && request.auth.uid in request.resource.data.memberIds && resource.data.inviteCode is string;
   allow delete: if false;
   match /channels/{channelId}{
    allow read: if serverMember(id);
    allow create: if serverMember(id) && get(/databases/$(database)/documents/servers/$(id)).data.ownerId==request.auth.uid && request.resource.data.createdBy==request.auth.uid;
    allow update,delete: if false;
    match /messages/{messageId}{
     allow read: if serverMember(id);
     allow create: if serverMember(id) && request.resource.data.senderId==request.auth.uid && request.resource.data.text is string && request.resource.data.text.size()>0 && request.resource.data.text.size()<=4000;
     allow update,delete: if false;
    }
   }
  }
 }
}